<Page
    x:Class="Sucrose.Portal.Views.Pages.SteamStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Sucrose.Portal.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vcontrols="clr-namespace:Sucrose.Portal.Views.Controls"
    Title="{DynamicResource Portal.SteamPage.Title}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    Loaded="SteamStorePage_Loaded"
    Unloaded="SteamStorePage_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:SizeConstrainingContainer Grid.Column="0">
            <ListBox
                x:Name="TagList"
                Width="200"
                Margin="7,0,7,0"
                BorderThickness="0"
                Background="Transparent"
                SelectionChanged="TagList_SelectionChanged" />
        </controls:SizeConstrainingContainer>

        <controls:SizeConstrainingContainer Grid.Column="1">
            <ui:DynamicScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="7,0,10,0">
                    <WrapPanel Margin="0,0,0,6">
                        <PasswordBox
                            x:Name="ApiKey"
                            Width="220"
                            Margin="0,0,6,6"
                            LostFocus="ApiKey_LostFocus" />
                        <ui:TextBox
                            x:Name="SearchBox"
                            Width="200"
                            Margin="0,0,6,6"
                            KeyDown="SearchBox_KeyDown"
                            PlaceholderText="{DynamicResource Portal.SteamPage.Search}" />
                        <ComboBox
                            x:Name="TypeFilter"
                            MinWidth="150"
                            Margin="0,0,6,6"
                            SelectionChanged="TypeFilter_SelectionChanged" />
                        <ComboBox
                            x:Name="SortFilter"
                            MinWidth="150"
                            Margin="0,0,6,6"
                            SelectionChanged="SortFilter_SelectionChanged" />
                        <ui:Button
                            x:Name="Refresh"
                            Margin="0,0,0,6"
                            Click="Refresh_Click"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                    </WrapPanel>

                    <ui:TextBlock
                        x:Name="Status"
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <controls:StoreStackPanel
                        x:Name="ThemeStore"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" />

                    <vcontrols:Pagination
                        x:Name="ThemePagination"
                        Margin="0,10,0,10"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed" />
                </StackPanel>
            </ui:DynamicScrollViewer>
        </controls:SizeConstrainingContainer>
    </Grid>
</Page>
