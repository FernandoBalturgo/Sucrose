<ui:ContentDialog
    x:Class="Sucrose.Portal.Views.Controls.StorePreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sucrose.Portal.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:xag="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
    Title="{DynamicResource Portal.StoreCard.TitleText}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    CloseButtonText="{DynamicResource Portal.ThemeReport.Close}"
    DialogMaxWidth="1000"
    Loaded="ContentDialog_Loaded"
    Unloaded="ContentDialog_Unloaded"
    mc:Ignorable="d">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:StorePreview}" />
    </ui:ContentDialog.Resources>

    <Grid MinWidth="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Height="560"
            ClipToBounds="True"
            CornerRadius="10">
            <Grid>
                <Image
                    x:Name="Imagine"
                    FlowDirection="LeftToRight"
                    Source="{x:Null}"
                    Stretch="Uniform" />
                <Image
                    x:Name="Imaginer"
                    FlowDirection="LeftToRight"
                    Stretch="Uniform"
                    StretchDirection="Both"
                    xag:AnimationBehavior.AnimateInDesignMode="False"
                    xag:AnimationBehavior.AutoStart="True"
                    xag:AnimationBehavior.CacheFramesInMemory="False"
                    xag:AnimationBehavior.RepeatBehavior="Forever"
                    xag:AnimationBehavior.SourceUri="{x:Null}" />
            </Grid>
        </Border>

        <ui:Card Grid.Row="1" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        x:Name="ThemeTitle"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{DynamicResource Portal.StoreCard.TitleText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <ui:TextBlock
                        x:Name="ThemeDescription"
                        Margin="0,5,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.StoreCard.DescriptionText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        x:Name="ThemeMeta"
                        Margin="0,5,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextPlaceholderColorBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ui:Button
                    x:Name="Download"
                    Grid.Column="1"
                    Width="48"
                    Height="48"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Appearance="Transparent"
                    BorderBrush="Transparent"
                    Click="Download_Click">
                    <Grid>
                        <ui:SymbolIcon
                            x:Name="IncompatibleVersion"
                            Width="36"
                            Cursor="Hand"
                            FontSize="36"
                            Foreground="{DynamicResource PaletteRedBrush}"
                            Symbol="BoxDismiss24"
                            ToolTipService.ToolTip="{DynamicResource Portal.StoreCard.VersionTip}"
                            Visibility="Collapsed" />
                        <ui:SymbolIcon
                            x:Name="DownloadSymbol"
                            Width="36"
                            Cursor="Hand"
                            FontSize="36"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Symbol="CloudArrowDown24" />
                        <ui:ProgressRing
                            x:Name="DownloadRing"
                            Width="36"
                            Height="36"
                            Progress="0"
                            Visibility="Collapsed" />
                    </Grid>
                </ui:Button>
            </Grid>
        </ui:Card>
    </Grid>
</ui:ContentDialog>