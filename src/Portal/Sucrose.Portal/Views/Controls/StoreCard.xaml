<UserControl
    x:Class="Sucrose.Portal.Views.Controls.StoreCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:xag="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
    xmlns:xf="clr-namespace:XamlFlair;assembly=XamlFlair.WPF"
    xf:Animations.Primary="{xf:Animate BasedOn={StaticResource Entered},
                                       Event=MouseEnter}"
    xf:Animations.Secondary="{xf:Animate BasedOn={StaticResource Leaved},
                                         Event=MouseLeave}"
    Cursor="Hand"
    Loaded="StoreCard_Loaded"
    MouseEnter="StoreCard_MouseEnter"
    MouseLeave="StoreCard_MouseLeave"
    MouseLeftButtonUp="StoreCard_MouseLeftButtonUp"
    mc:Ignorable="d">

    <UserControl.ContextMenu>
        <ContextMenu
            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
            Opacity="0.9"
            Opened="ContextMenu_Opened">
            <ui:MenuItem
                x:Name="MenuUpdate"
                Click="MenuUpdate_Click"
                Cursor="Hand"
                Header="{DynamicResource Portal.StoreCard.MenuUpdate}"
                Icon="{ui:SymbolIcon BoxSearch24}"
                Visibility="Collapsed" />
            <ui:MenuItem
                x:Name="MenuInstall"
                Click="MenuInstall_Click"
                Cursor="Hand"
                Header="{DynamicResource Portal.StoreCard.MenuInstall}"
                Icon="{ui:SymbolIcon ImageAdd24}" />
            <ui:MenuItem
                x:Name="MenuReport"
                Click="MenuReport_Click"
                Cursor="Hand"
                Header="{DynamicResource Portal.StoreCard.MenuReport}"
                Icon="{ui:SymbolIcon PersonFeedback24}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True"
        CornerRadius="10">
        <!--<Border.Effect>
            <DropShadowEffect
                BlurRadius="10"
                Direction="300"
                Opacity="0.25"
                ShadowDepth="12"
                Color="{DynamicResource SolidBackgroundFillColorBaseAlt}" />
        </Border.Effect>-->

        <Grid>
            <Border
                x:Name="Progress"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClipToBounds="True"
                CornerRadius="10">
                <Border.Background>
                    <SolidColorBrush Opacity="0.5" Color="{DynamicResource ApplicationBackgroundColor}" />
                </Border.Background>
                <ui:ProgressRing
                    Width="120"
                    Height="120"
                    IsIndeterminate="True" />
            </Border>

            <Border
                x:Name="Warn"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClipToBounds="True"
                CornerRadius="10"
                Visibility="Hidden">
                <Border.Background>
                    <SolidColorBrush Opacity="0.5" Color="{DynamicResource ApplicationBackgroundColor}" />
                </Border.Background>

                <ui:ProgressRing
                    Width="120"
                    Height="120"
                    Foreground="Crimson"
                    IsIndeterminate="False"
                    Progress="100" />
            </Border>

            <Grid x:Name="Card" Visibility="Hidden">
                <Rectangle
                    FlowDirection="LeftToRight"
                    RadiusX="10"
                    RadiusY="10">
                    <Rectangle.Fill>
                        <VisualBrush Stretch="UniformToFill">
                            <VisualBrush.Visual>
                                <Grid FlowDirection="LeftToRight">
                                    <Image
                                        x:Name="Imagine"
                                        FlowDirection="LeftToRight"
                                        Source="{x:Null}"
                                        Stretch="UniformToFill" />
                                    <Image
                                        x:Name="Imaginer"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        xag:AnimationBehavior.AnimateInDesignMode="False"
                                        xag:AnimationBehavior.AutoStart="True"
                                        xag:AnimationBehavior.CacheFramesInMemory="False"
                                        xag:AnimationBehavior.RepeatBehavior="Forever"
                                        xag:AnimationBehavior.SourceUri="{x:Null}"
                                        FlowDirection="LeftToRight"
                                        Stretch="UniformToFill"
                                        StretchDirection="Both" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Border
                    x:Name="InfoBadge"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    CornerRadius="0,0,10,10"
                    Opacity="0.75">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource SolidBackgroundFillColorQuarternary}" />
                    </Border.Background>
                    <StackPanel
                        Margin="6,2"
                        Orientation="Horizontal">
                        <ui:TextBlock
                            x:Name="ThemeType"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock
                            x:Name="ThemeSize"
                            Margin="8,0,0,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>